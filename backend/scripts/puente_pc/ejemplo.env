# Copiar este archivo a /etc/puente-lector.env y poner los valores reales.
# Los valores estan en el .env de la Mac del dueno (no se suben a git).

# Direccion del lector en la red local de la cafeteria.
LECTOR_HOST=192.168.0.31
LECTOR_USUARIO=admin
LECTOR_PASSWORD=PONER_LA_CLAVE_DEL_LECTOR

# Tiene que ser IDENTICA a la variable LECTOR_API_KEY del servidor en Render.
LECTOR_API_KEY=PONER_LA_CLAVE_DEL_SISTEMA

SISTEMA_URL=https://coffe-shop-4ffg.onrender.com
LECTOR_INTERVALO_SEG=30
